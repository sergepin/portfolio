---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('projects.title')}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">{t('projects.title')}</h1>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">{t('projects.featured')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Accomplishments App -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-3">Accomplishments App</h3>
          <p class="text-gray-600 mb-4">Company-wide achievement sharing platform enabling employees to recognize and celebrate successes.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">Next.js</span>
            <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">Node.js</span>
            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm">MongoDB</span>
          </div>
        </div>

        <!-- ADA Compliance Initiative -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-3">ADA Compliance Initiative</h3>
          <p class="text-gray-600 mb-4">Led comprehensive accessibility improvements across 50+ e-commerce websites.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">C#</span>
            <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm">.NET</span>
            <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">Accessibility</span>
          </div>
        </div>

        <!-- Inventory Forecasting App -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-3">Inventory Forecasting App</h3>
          <p class="text-gray-600 mb-4">Modern web application for stock level visualization and trend analysis.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">Next.js</span>
            <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">Node.js</span>
            <span class="px-3 py-1 bg-pink-100 text-pink-800 rounded-full text-sm">GraphQL</span>
            <span class="px-3 py-1 bg-cyan-100 text-cyan-800 rounded-full text-sm">PostgreSQL</span>
          </div>
        </div>

        <!-- E-commerce Platform Migration -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-3">E-commerce Platform Migration</h3>
          <p class="text-gray-600 mb-4">Led migration of legacy .NET websites to modern Next.js platform.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">Next.js</span>
            <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">Node.js</span>
            <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">C#</span>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">{t('projects.tech')}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <!-- Frontend -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-4">{t('projects.frontend')}</h3>
          <div class="space-y-3">
            <div class="flex items-center">
              <img src="/icons/react.svg" alt="React" class="w-6 h-6 mr-2">
              <span>React</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/angular.svg" alt="Angular" class="w-6 h-6 mr-2">
              <span>Angular</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/vue.svg" alt="Vue" class="w-6 h-6 mr-2">
              <span>Vue</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/nextjs.svg" alt="Next.js" class="w-6 h-6 mr-2">
              <span>Next.js</span>
            </div>
          </div>
        </div>

        <!-- Backend -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-4">{t('projects.backend')}</h3>
          <div class="space-y-3">
            <div class="flex items-center">
              <img src="/icons/nodejs.svg" alt="Node.js" class="w-6 h-6 mr-2">
              <span>Node.js</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/nestjs.svg" alt="NestJS" class="w-6 h-6 mr-2">
              <span>NestJS</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/dotnet.svg" alt=".NET" class="w-6 h-6 mr-2">
              <span>.NET</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/python.svg" alt="Python" class="w-6 h-6 mr-2">
              <span>Python</span>
            </div>
          </div>
        </div>

        <!-- Cloud & DevOps -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-4">{t('projects.cloud')}</h3>
          <div class="space-y-3">
            <div class="flex items-center">
              <img src="/icons/aws.svg" alt="AWS" class="w-6 h-6 mr-2">
              <span>AWS</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/ec2.svg" alt="EC2" class="w-6 h-6 mr-2">
              <span>EC2</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/lambda.svg" alt="Lambda" class="w-6 h-6 mr-2">
              <span>Lambda</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/s3.svg" alt="S3" class="w-6 h-6 mr-2">
              <span>S3</span>
            </div>
          </div>
        </div>

        <!-- Databases -->
        <div class="bg-white rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-semibold mb-4">{t('projects.databases')}</h3>
          <div class="space-y-3">
            <div class="flex items-center">
              <img src="/icons/mongodb.svg" alt="MongoDB" class="w-6 h-6 mr-2">
              <span>MongoDB</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/postgresql.svg" alt="PostgreSQL" class="w-6 h-6 mr-2">
              <span>PostgreSQL</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/sqlserver.svg" alt="SQL Server" class="w-6 h-6 mr-2">
              <span>SQL Server</span>
            </div>
            <div class="flex items-center">
              <img src="/icons/mysql.svg" alt="MySQL" class="w-6 h-6 mr-2">
              <span>MySQL</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout> 