---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type ProfessionalProjectKey = 'accomplishments' | 'inventory' | 'ada' | 'migration';
type PersonalProjectKey = 'lion-pos' | 'invoice';

const professionalProjects = [
  {
    key: 'accomplishments' as ProfessionalProjectKey,
    technologies: ['Next.js', 'Node.js', 'MongoDB']
  },
  {
    key: 'inventory' as ProfessionalProjectKey,
    technologies: ['Next.js', 'Django', 'GraphQL', 'PostgreSQL']
  },
  {
    key: 'ada' as ProfessionalProjectKey,
    technologies: ['C#', '.NET']
  },
  {
    key: 'migration' as ProfessionalProjectKey,
    technologies: ['Next.js', 'Node.js', 'MSSQL']
  }
];

const personalProjects = [
  {
    key: 'lion-pos' as PersonalProjectKey,
    technologies: ['React', 'Tauri (Rust)'],
    image: '/images/lion-pos.png',
    codeLink: ''
  },
  {
    key: 'invoice' as PersonalProjectKey,
    technologies: ['Angular', 'NestJS'],
    image: '/images/invoice-app.png',
    codeLink: ''
  }
];
---

<Layout title={t('projects.title')}>
  <main class="container mx-auto px-6 md:px-12 py-12 md:py-16">
    <div class="max-w-5xl mx-auto space-y-12 md:space-y-16">
      <h1 class="text-4xl md:text-5xl font-extrabold text-primary text-center">{t('projects.title')}</h1>
      
      <section>
        <h2 class="text-2xl md:text-3xl font-semibold text-primary mb-6 md:mb-8">{t('projects.professional')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          {professionalProjects.map(project => (
            <div class="bg-background-primary rounded-2xl shadow-lg p-6 md:p-8 hover:shadow-2xl transition">
              <h3 class="text-xl md:text-2xl font-semibold text-primary">{t(`projects.professional.${project.key}.name`)}</h3>
              <p class="text-base md:text-lg text-secondary mt-2">{t(`projects.professional.${project.key}.description`)}</p>
              <p class="text-sm md:text-base text-secondary mt-3 font-medium">{t('projects.technologies')}: {project.technologies.join(', ')}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-semibold text-primary mb-6 md:mb-8">{t('projects.personal')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          {personalProjects.map(project => (
            <a href="#" class="bg-background-primary rounded-2xl shadow-lg p-6 md:p-8 block hover:shadow-2xl transition transform hover:scale-105">
              <img src={project.image} alt={t(`projects.personal.${project.key}.name`)} class="w-full h-40 md:h-48 object-cover rounded-lg mb-4" />
              <h3 class="text-xl md:text-2xl font-semibold text-primary">{t(`projects.personal.${project.key}.name`)}</h3>
              <p class="text-base md:text-lg text-secondary mt-2">{t(`projects.personal.${project.key}.description`)}</p>
              <p class="text-sm md:text-base text-secondary mt-2 font-medium">{t('projects.technologies')}: {project.technologies.join(', ')}</p>
              {project.codeLink && <a href={project.codeLink} target="_blank" class="text-blue-500 text-sm md:text-base mt-3 block font-medium underline">{t('projects.view-code')}</a>}
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>