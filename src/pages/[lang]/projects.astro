---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export interface Props {}

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
  {
    title: 'Accomplishments App',
    description: 'Company-wide achievement sharing platform enabling employees to recognize and celebrate successes.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'MongoDB', color: 'bg-yellow-500 text-white' }
    ]
  },
  {
    title: 'ADA Compliance Initiative',
    description: 'Led comprehensive accessibility improvements across 50+ e-commerce websites.',
    technologies: [
      { name: 'C#', color: 'bg-purple-500 text-white' },
      { name: '.NET', color: 'bg-red-500 text-white' },
      { name: 'Accessibility', color: 'bg-indigo-500 text-white' }
    ]
  },
  {
    title: 'Inventory Forecasting App',
    description: 'Modern web application for stock level visualization and trend analysis.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'GraphQL', color: 'bg-pink-500 text-white' },
      { name: 'PostgreSQL', color: 'bg-cyan-500 text-white' }
    ]
  },
  {
    title: 'E-commerce Platform Migration',
    description: 'Led migration of legacy .NET websites to modern Next.js platform.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'C#', color: 'bg-purple-500 text-white' }
    ]
  }
];

const techCategories = [
  {
    title: t('projects.frontend'),
    technologies: [
      { name: 'React', icon: 'react.svg' },
      { name: 'Angular', icon: 'angular.svg' },
      { name: 'Vue', icon: 'vue.svg' },
      { name: 'Next.js', icon: 'nextjs.svg' }
    ]
  },
  {
    title: t('projects.backend'),
    technologies: [
      { name: 'Node.js', icon: 'nodejs.svg' },
      { name: 'NestJS', icon: 'nestjs.svg' },
      { name: '.NET', icon: 'dotnet.svg' },
      { name: 'Python', icon: 'python.svg' }
    ]
  },
  {
    title: t('projects.cloud'),
    technologies: [
      { name: 'AWS', icon: 'aws.svg' },
      { name: 'Lambda', icon: 'lambda.svg' },
      { name: 'EC2', icon: 'ec2.svg'},
      { name: 'S3', icon: 's3.svg' }
    ]
  },
  {
    title: t('projects.databases'),
    technologies: [
      { name: 'PostgreSQL', icon: 'postgresql.svg' },
      { name: 'MongoDB', icon: 'mongodb.svg' },
      { name: 'MySQL', icon: 'mysql.svg' },
      { name: 'SQL Server', icon: 'sqlserver.svg' }
    ]
  }
];
---

<Layout title={t('projects.title')}>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-8 text-primary">{t('projects.title')}</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-background-primary rounded-lg shadow-lg overflow-hidden">
          <img src="/images/project1.jpg" alt="Project 1" class="w-full h-48 object-cover">
          <div class="p-6">
            <h2 class="text-2xl font-semibold mb-2 text-primary">E-commerce Platform</h2>
            <p class="text-secondary mb-4">A full-stack e-commerce solution built with React and Node.js</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">React</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Node.js</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">MongoDB</span>
            </div>
          </div>
        </div>

        <div class="bg-background-primary rounded-lg shadow-lg overflow-hidden">
          <img src="/images/project2.jpg" alt="Project 2" class="w-full h-48 object-cover">
          <div class="p-6">
            <h2 class="text-2xl font-semibold mb-2 text-primary">Task Management App</h2>
            <p class="text-secondary mb-4">A collaborative task management application with real-time updates</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Vue.js</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Firebase</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Tailwind CSS</span>
            </div>
          </div>
        </div>

        <div class="bg-background-primary rounded-lg shadow-lg overflow-hidden">
          <img src="/images/project3.jpg" alt="Project 3" class="w-full h-48 object-cover">
          <div class="p-6">
            <h2 class="text-2xl font-semibold mb-2 text-primary">Weather Dashboard</h2>
            <p class="text-secondary mb-4">A weather dashboard showing real-time weather data and forecasts</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Angular</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">OpenWeather API</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Chart.js</span>
            </div>
          </div>
        </div>

        <div class="bg-background-primary rounded-lg shadow-lg overflow-hidden">
          <img src="/images/project4.jpg" alt="Project 4" class="w-full h-48 object-cover">
          <div class="p-6">
            <h2 class="text-2xl font-semibold mb-2 text-primary">Portfolio Website</h2>
            <p class="text-secondary mb-4">A responsive portfolio website built with modern web technologies</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Astro</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">Tailwind CSS</span>
              <span class="px-3 py-1 bg-background-secondary rounded-full text-sm text-secondary">TypeScript</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>