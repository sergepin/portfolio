---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = [
  {
    title: 'Accomplishments App',
    description: 'Company-wide achievement sharing platform enabling employees to recognize and celebrate successes.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'MongoDB', color: 'bg-yellow-500 text-white' }
    ]
  },
  {
    title: 'ADA Compliance Initiative',
    description: 'Led comprehensive accessibility improvements across 50+ e-commerce websites.',
    technologies: [
      { name: 'C#', color: 'bg-purple-500 text-white' },
      { name: '.NET', color: 'bg-red-500 text-white' },
      { name: 'Accessibility', color: 'bg-indigo-500 text-white' }
    ]
  },
  {
    title: 'Inventory Forecasting App',
    description: 'Modern web application for stock level visualization and trend analysis.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'GraphQL', color: 'bg-pink-500 text-white' },
      { name: 'PostgreSQL', color: 'bg-cyan-500 text-white' }
    ]
  },
  {
    title: 'E-commerce Platform Migration',
    description: 'Led migration of legacy .NET websites to modern Next.js platform.',
    technologies: [
      { name: 'Next.js', color: 'bg-blue-500 text-white' },
      { name: 'Node.js', color: 'bg-green-500 text-white' },
      { name: 'C#', color: 'bg-purple-500 text-white' }
    ]
  }
];

const techCategories = [
  {
    title: t('projects.frontend'),
    technologies: [
      { name: 'React', icon: 'react.svg' },
      { name: 'Angular', icon: 'angular.svg' },
      { name: 'Vue', icon: 'vue.svg' },
      { name: 'Next.js', icon: 'nextjs.svg' }
    ]
  },
  {
    title: t('projects.backend'),
    technologies: [
      { name: 'Node.js', icon: 'nodejs.svg' },
      { name: 'NestJS', icon: 'nestjs.svg' },
      { name: '.NET', icon: 'dotnet.svg' },
      { name: 'Python', icon: 'python.svg' }
    ]
  },
  {
    title: t('projects.cloud'),
    technologies: [
      { name: 'AWS', icon: 'aws.svg' },
      { name: 'Lambda', icon: 'lambda.svg' },
      { name: 'EC2', icon: 'ec2.svg'},
      { name: 'S3', icon: 's3.svg' }
    ]
  },
  {
    title: t('projects.databases'),
    technologies: [
      { name: 'PostgreSQL', icon: 'postgresql.svg' },
      { name: 'MongoDB', icon: 'mongodb.svg' },
      { name: 'MySQL', icon: 'mysql.svg' },
      { name: 'SQL Server', icon: 'sqlserver.svg' }
    ]
  }
];
---

<Layout title={t('projects.title')}>
  <main class="container mx-auto px-6 py-12 bg-gray-900 text-gray-100">
    <h1 class="text-5xl font-extrabold mb-10 text-center">{t('projects.title')}</h1>

    <section class="mb-16">
      <h2 class="text-3xl font-semibold mb-8 text-center">{t('projects.featured')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map(project => (
          <div class="bg-gray-800 rounded-2xl shadow-md p-6 hover:shadow-lg transition">
            <h3 class="text-2xl font-bold mb-4">{project.title}</h3>
            <p class="text-gray-300 mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map(tech => (
                <span class={`px-4 py-1 rounded-full text-sm font-medium ${tech.color}`}>{tech.name}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-3xl font-semibold mb-8 text-center">{t('projects.tech')}</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        {techCategories.map(category => (
          <div class="bg-gray-800 rounded-2xl shadow-md p-6 hover:shadow-lg transition">
            <h3 class="text-2xl font-bold mb-6 text-center">{category.title}</h3>
            <div class="flex flex-col gap-4">
              {category.technologies.map(tech => (
                <div class="flex items-center gap-3">
                  <img src={`/icons/${tech.icon}`} alt={tech.name} class="w-6 h-6" />
                  <span class="text-gray-100">{tech.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>