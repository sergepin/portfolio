---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';


export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('contact.title')}>
  <main class="container mx-auto px-4 md:px-6 py-8 md:py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-primary text-center mb-8 md:mb-12">{t('contact.title')}</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        <!-- Contact Form -->
        <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-8">
          <h2 class="text-xl md:text-2xl font-semibold text-primary mb-6">{t('contact.form.title')}</h2>
          <form class="space-y-4 md:space-y-6">
            <div>
              <label for="name" class="block text-sm md:text-base font-medium text-secondary mb-1">{t('contact.form.name')}</label>
              <input type="text" id="name" name="name" required
                class="w-full px-3 py-2 md:py-3 bg-background-secondary border border-border rounded-lg text-primary focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label for="email" class="block text-sm md:text-base font-medium text-secondary mb-1">{t('contact.form.email')}</label>
              <input type="email" id="email" name="email" required
                class="w-full px-3 py-2 md:py-3 bg-background-secondary border border-border rounded-lg text-primary focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label for="subject" class="block text-sm md:text-base font-medium text-secondary mb-1">{t('contact.form.subject')}</label>
              <input type="text" id="subject" name="subject" required
                class="w-full px-3 py-2 md:py-3 bg-background-secondary border border-border rounded-lg text-primary focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label for="message" class="block text-sm md:text-base font-medium text-secondary mb-1">{t('contact.form.message')}</label>
              <textarea id="message" name="message" rows="4" required
                class="w-full px-3 py-2 md:py-3 bg-background-secondary border border-border rounded-lg text-primary focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
            <button type="submit"
              class="w-full px-4 md:px-6 py-2 md:py-3 bg-background-secondary text-secondary rounded-lg hover:bg-opacity-80 transition-colors duration-200">
              {t('contact.form.send')}
            </button>
          </form>
        </div>

        <!-- Contact Information -->
        <div class="space-y-6 md:space-y-8">
          <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-6">
            <h2 class="text-xl md:text-2xl font-semibold text-primary mb-4 md:mb-6">{t('contact.info.title')}</h2>
            <div class="space-y-4 md:space-y-6">
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 md:h-6 md:w-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm md:text-base font-medium text-primary">{t('contact.info.email')}</p>
                  <p class="text-sm md:text-base text-secondary">your.email@example.com</p>
                </div>
              </div>

              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 md:h-6 md:w-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm md:text-base font-medium text-primary">{t('contact.info.location')}</p>
                  <p class="text-sm md:text-base text-secondary">Barranquilla, Colombia</p>
                </div>
              </div>

              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 md:h-6 md:w-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm md:text-base font-medium text-primary">{t('contact.info.linkedin')}</p>
                  <a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer"
                    class="text-sm md:text-base text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">linkedin.com/in/your-profile</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Media Links -->
          <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-6">
            <h3 class="text-lg md:text-xl font-medium text-primary mb-4">{t('contact.social.title')}</h3>
            <div class="flex space-x-4">
              <a href="https://linkedin.com/in/your-profile" target="_blank" rel="noopener noreferrer"
                class="text-secondary hover:text-primary transition-colors">
                <span class="sr-only">LinkedIn</span>
                <svg class="h-5 w-5 md:h-6 md:w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-.88-.016-2.005-1.22-2.005-1.22 0-1.41.952-1.41 1.94v5.669h-3v-11h3v1.61c.42-.81 1.16-1.63 2.82-1.63 3.01 0 3.77 1.99 3.77 4.58v6.44z" />
                </svg>
              </a>
              <a href="https://github.com/your-profile" target="_blank" rel="noopener noreferrer"
                class="text-secondary hover:text-primary transition-colors">
                <span class="sr-only">GitHub</span>
                <svg class="h-5 w-5 md:h-6 md:w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.91-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout> 