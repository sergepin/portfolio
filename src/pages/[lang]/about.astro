---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import AboutExperience from '../../components/AboutExperience.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experiences = [
  {
    dates: lang === 'en' ? "2021 · Present" : "2021 · Presente",
    role: lang === 'en' ? "Fullstack Web Developer" : "Desarrollador Web Fullstack",
    company: "Appxcale LLC",
    description: lang === 'en'
      ? "Supporting a major U.S. company managing over 50 e-commerce sites. Responsible for maintenance, new features, ADA compliance, and internal tools using React, Angular, Vue, NestJS, and NextJS. Leading projects and developing stored procedures in Microsoft SQL."
      : "Brindo soporte a una empresa de EE. UU. que gestiona más de 50 sitios e-commerce. Encargado de mantenimiento, nuevas funcionalidades, cumplimiento ADA y herramientas internas con React, Angular, Vue, NestJS y NextJS. Lidero proyectos y desarrollo procedimientos almacenados en SQL Server.",
    technologies: [
      "React", "Angular", "Vue", "Next.js", "NestJS",
      "Node.js", "C#", ".NET", "Microsoft SQL Server",
      "GraphQL", "MongoDB", "PostgreSQL", "AWS (EC2, Lambda, S3)"
    ],
    logo: "/icons/appxcale.ico"
  },
  {
    dates: lang === 'en' ? "2020 · 2021" : "2020 · 2021",
    role: lang === 'en' ? "Junior Developer" : "Desarrollador Junior",
    company: "Biinteli S.A.S",
    description: lang === 'en'
      ? "Maintained and implemented new features for a retailer's e-commerce site. Led migration from AngularJS to Angular, coordinated with API providers, and managed deployments."
      : "Mantenimiento e implementación de nuevas funcionalidades para un sitio e-commerce. Lideré la migración de AngularJS a Angular, coordiné con proveedores de API y gestioné despliegues.",
    technologies: [
      "AngularJS", "Angular", "Node.js", "JavaScript", "HTML", "CSS"
    ],
    logo: "/icons/biinteli.png"
  }
];

---

<Layout title={t('about.title')}>
  <main class="container mx-auto px-6 md:px-12 py-12 md:py-16">
    <div class="max-w-5xl mx-auto space-y-12 md:space-y-16">
      <h1 class="text-4xl md:text-5xl font-extrabold text-primary text-center">{t('about.title')}</h1>
      
      <section>
        <h2 class="text-2xl md:text-3xl font-semibold text-primary mb-6 md:mb-8">{t('about.who-am-i')}</h2>
        <p class="text-lg md:text-xl text-secondary leading-relaxed">{t('about.who-am-i-text-1')}</p>
        <p class="text-lg md:text-xl text-secondary leading-relaxed mt-4">{t('about.who-am-i-text-2')}</p>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl font-semibold text-primary mb-6 md:mb-8">{t('about.what-drives-me')}</h2>
        <p class="text-lg md:text-xl text-secondary leading-relaxed">{t('about.what-drives-me-text-1')}</p>
        <p class="text-lg md:text-xl text-secondary leading-relaxed mt-4">{t('about.what-drives-me-text-2')}</p>
      </section>


      <section>
        <h2 class="text-2xl md:text-3xl font-semibold text-[var(--text-primary)] mb-6 md:mb-8 relative inline-block">
          <span class="relative z-10">{lang === 'en' ? 'Experience' : 'Experiencia'}</span>
          <span class="absolute bottom-1 left-0 w-full h-2 bg-[var(--color-secondary)] opacity-20 rounded"></span>
        </h2>
        <div class="px-6 py-8 bg-[var(--bg-secondary)]/50 rounded-xl shadow-md ring-1 ring-[var(--border-color)] backdrop-blur-sm">
          {
            experiences.map((experience, index) => {
              return (
                <div class={`${index !== experiences.length - 1 ? 'mb-16' : ''}`}>
                  <AboutExperience
                    dates={experience.dates}
                    role={experience.role}
                    company={experience.company}
                    description={experience.description}
                    logo={experience.logo}
                    technologies={experience.technologies}
                    technologiesLabel={lang === 'en' ? 'Technologies' : 'Tecnologías'}
                  />
                </div>
              )
            })
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
