---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skills = ['react', 'nodejs', 'python', 'aws'];
const softSkills = [
  { name: 'Team Leadership', color: 'green' },
  { name: 'Communication', color: 'blue' },
  { name: 'Problem Solving', color: 'purple' }
];

const experience = [
  {
    role: 'Senior Full Stack Developer',
    company: 'Tech Company',
    years: '2020 - Present',
    tasks: ['Led development of full-stack applications', 'Implemented CI/CD pipelines', 'Mentored junior developers']
  },
  {
    role: 'Full Stack Developer',
    company: 'Digital Agency',
    years: '2018 - 2020',
    tasks: ['Developed responsive web applications', 'Optimized performance', 'Improved UI/UX with design team']
  }
];

const accomplishments = [
  {
    title: 'Technical Achievement',
    color: 'yellow',
    description: 'Migrated legacy systems to cloud, improving performance by 40%.'
  },
  {
    title: 'Team Achievement',
    color: 'green',
    description: 'Created a mentoring program that promoted juniors to seniors in 2 years.'
  }
];
---

<Layout title={t('about.title')}>
  <main class="container mx-auto px-6 py-12">
    <div class="max-w-4xl mx-auto space-y-12">
      <h1 class="text-4xl font-extrabold text-primary text-center">{t('about.title')}</h1>
      
      <section class="bg-background-primary rounded-lg shadow p-8">
        <p class="text-lg text-secondary leading-relaxed">{t('about.introduction')}</p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-primary mb-6">{t('about.skills')}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-background-primary rounded-lg shadow p-6 space-y-4">
            <h3 class="text-xl font-semibold text-primary">{t('about.technical')}</h3>
            <div class="space-y-3">
              {skills.map(skill => (
                <div class="flex items-center">
                  <img src={`/icons/${skill}.svg`} alt={skill} class="w-6 h-6 mr-2">
                  <span class="text-secondary capitalize">{skill}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-background-primary rounded-lg shadow p-6 space-y-4">
            <h3 class="text-xl font-semibold text-primary">{t('about.soft')}</h3>
            <div class="space-y-3">
              {softSkills.map(({ name, color }) => (
                <div class="flex items-center">
                  <svg class={`w-6 h-6 mr-2 text-${color}-500`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20h9m-9-2h9M3 12h18M3 10h18m-9-8v16" />
                  </svg>
                  <span class="text-secondary">{name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-primary mb-6">{t('about.experience')}</h2>
        <div class="space-y-6">
          {experience.map(job => (
            <div class="bg-background-primary rounded-lg shadow p-6">
              <h3 class="text-xl font-semibold text-primary">{job.role}</h3>
              <p class="text-secondary mb-2">{job.company} • {job.years}</p>
              <ul class="list-disc list-inside text-secondary space-y-2">
                {job.tasks.map(task => <li>{task}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-primary mb-6">{t('about.education')}</h2>
        <div class="bg-background-primary rounded-lg shadow p-6">
          <h3 class="text-xl font-semibold text-primary">Bachelor of Computer Science</h3>
          <p class="text-secondary">University of Technology • 2014 - 2018</p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-primary mb-6">{t('about.accomplishments')}</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {accomplishments.map(accomplishment => (
            <div class="bg-background-primary rounded-lg shadow p-6">
              <div class="flex items-center mb-4">
                <svg class={`w-6 h-6 text-${accomplishment.color}-500 mr-2`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
                <h3 class="text-lg font-semibold text-primary">{accomplishment.title}</h3>
              </div>
              <p class="text-secondary">{accomplishment.description}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
