---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export interface Props {}

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import LogoWall from "../../components/logoWall.astro";
import SkillsList from "../../components/SkillsList.tsx";
---

<Layout 
  title={t('home.title')}
  description={t('home.description')}
>
  
  <section class="text-primary text-[var(--white)] min-h-[calc(100vh-8rem)] flex items-center py-12 sm:py-16" id="home">
    <div class="max-w-6xl mx-auto px-4 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="space-y-6">
          <div class="space-y-4">
            <p class="text-lg md:text-xl text-secondary text-[var(--white-icon)] shiny-white font-medium">
              {lang === 'en' ? "Hi, I'm Sergio Pinzon" : "Hola, soy Sergio Pinzon"}
            </p>
            <div class="space-y-4">
              <h1 class="text-primary text-[var(--white)] text-5xl md:text-6xl font-bold text-pretty leading-tight">
                {lang === 'en' ? "Software" : "Desarrollador"} <br /> {lang === 'en' ? "Developer" : "de Software"}
              </h1>
              <p class="text-lg md:text-xl text-secondary text-[var(--white-icon)] max-w-xl">
                {lang === 'en' 
                  ? "I'm a fullstack web developer specializing in backend development and AI, transforming ideas into intelligent solutions."
                  : "Soy un desarrollador web fullstack especializado en desarrollo backend e IA, transformando ideas en soluciones inteligentes."}
              </p>
            </div>
            <div class="flex gap-3 pt-2">
              <a
                target="_blank"
                href="https://github.com/sergepin"
                aria-label="GitHub"
                class="text-gray-800 hover:text-primary transition duration-300 ease-in-out border border-gray-300 p-3 rounded-xl bg-white hover:bg-gray-100 shadow-md"
              >
                <img src="/icons/github.svg" alt="GitHub" class="w-6 h-6" />
              </a>
              <a
                target="_blank"
                href="https://www.linkedin.com/in/sergepind/"
                aria-label="LinkedIn"
                class="text-gray-800 hover:text-primary transition duration-300 ease-in-out border border-gray-300 p-3 rounded-xl bg-white hover:bg-gray-100 shadow-md"
              >
                <img src="/icons/LinkedIn.svg" alt="LinkedIn" class="w-6 h-6" />
              </a>
            </div>
          </div>
          <div class="pt-4">
            <LogoWall />
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <SkillsList client:load url={Astro.url} />
        </div>
      </div>
    </div>
  </section>

</Layout>
