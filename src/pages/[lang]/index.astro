---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export interface Props {}

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('home.title')}>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8 md:mb-12">
        <h1 class="text-3xl md:text-5xl font-bold mb-4 md:mb-6 text-primary">{t('home.title')}</h1>
        <p class="text-lg md:text-xl text-secondary mb-6 md:mb-8">{t('home.description')}</p>
        <a href={`/${lang}/projects`} class="inline-block px-4 md:px-6 py-2 md:py-3 bg-background-secondary rounded-lg text-secondary hover:bg-opacity-80 transition-colors duration-200">
          {t('home.cta')}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
        <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-6">
          <div class="flex items-center mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-blue-500 mr-2 md:mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <h2 class="text-lg md:text-xl font-semibold text-primary">{t('about.skills')}</h2>
          </div>
          <p class="text-sm md:text-base text-secondary">{t('about.introduction')}</p>
        </div>

        <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-6">
          <div class="flex items-center mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-green-500 mr-2 md:mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <h2 class="text-lg md:text-xl font-semibold text-primary">{t('about.experience')}</h2>
          </div>
          <p class="text-sm md:text-base text-secondary">{t('about.introduction')}</p>
        </div>

        <div class="bg-background-primary rounded-lg shadow-lg p-4 md:p-6">
          <div class="flex items-center mb-3 md:mb-4">
            <svg class="w-6 h-6 md:w-8 md:h-8 text-purple-500 mr-2 md:mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h2 class="text-lg md:text-xl font-semibold text-primary">{t('about.technical')}</h2>
          </div>
          <p class="text-sm md:text-base text-secondary">{t('about.introduction')}</p>
        </div>
      </div>
    </div>
  </main>
</Layout> 