---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';


export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('home.title')}>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto text-center text-blue-600">
      <h1 class="text-5xl font-bold mb-6">{t('home.title')}</h1>
      <p class="text-xl text-blue-600 mb-8">{t('home.description')}</p>
      <a href={`${lang}/projects`}
        class="inline-block bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors">
        {t('home.cta')}
      </a>
    </div>
  </main>
</Layout> 