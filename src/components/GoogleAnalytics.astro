---
import { analyticsConfig } from '../config/analytics';

// Solo renderizar si Google Tag Manager está habilitado
const shouldRenderGTM = analyticsConfig.googleTagManager.enabled;
const GTM_ID = analyticsConfig.googleTagManager.containerId;

// Solo renderizar si Google Analytics está habilitado
const shouldRenderGA = analyticsConfig.googleAnalytics.enabled;
const GA_MEASUREMENT_ID = analyticsConfig.googleAnalytics.measurementId;
---

{shouldRenderGA && (
  <>
    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '{GA_MEASUREMENT_ID}');
    </script>
  </>
)}

{shouldRenderGTM && (
  <>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','{GTM_ID}');
    </script>
    <!-- End Google Tag Manager -->
  </>
)}

{/* Eventos personalizados para tracking mejorado */}
<script is:inline>
  // Track page views con GTM y GA4
  document.addEventListener('astro:page-load', () => {
    if (window.dataLayer) {
      window.dataLayer.push({
        event: 'page_view',
        page_title: document.title,
        page_location: window.location.href,
        page_category: 'portfolio'
      });
    }
    
    // GA4 page view tracking
    if (window.gtag) {
      window.gtag('event', 'page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_category: 'portfolio'
      });
    }
  });

  // Track clicks en enlaces externos
  document.addEventListener('click', (e) => {
    const target = e.target;
    const link = target?.closest('a');
    if (link && link.hostname !== window.location.hostname) {
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'click_external_link',
          link_url: link.href,
          link_text: link.textContent,
          page_location: window.location.href
        });
      }
      
      if (window.gtag) {
        window.gtag('event', 'click_external_link', {
          link_url: link.href,
          link_text: link.textContent,
          page_location: window.location.href
        });
      }
    }
  });

  // Track descargas de CV
  document.addEventListener('click', (e) => {
    const target = e.target;
    const link = target?.closest('a');
    if (link && link.href.includes('.pdf')) {
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'download',
          file_name: link.href.split('/').pop(),
          file_type: 'pdf',
          page_location: window.location.href
        });
      }
      
      if (window.gtag) {
        window.gtag('event', 'download', {
          file_name: link.href.split('/').pop(),
          file_type: 'pdf',
          page_location: window.location.href
        });
      }
    }
  });

  // Track cambios de idioma
  document.addEventListener('click', (e) => {
    const target = e.target;
    const link = target?.closest('a');
    if (link && (link.href.includes('/en/') || link.href.includes('/es/'))) {
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'language_change',
          new_language: link.href.includes('/en/') ? 'english' : 'spanish',
          page_location: window.location.href
        });
      }
      
      if (window.gtag) {
        window.gtag('event', 'language_change', {
          new_language: link.href.includes('/en/') ? 'english' : 'spanish',
          page_location: window.location.href
        });
      }
    }
  });
</script> 