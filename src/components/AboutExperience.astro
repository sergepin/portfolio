---
interface Props {
  dates: string;
  role: string;
  company: string;
  description: string;
  logo: string;
  technologies?: string[];
  technologiesLabel?: string;
}

const { dates, role, company, description, logo, technologies = [], technologiesLabel = "Technologies" } = Astro.props;
---

<div class="relative pl-8 p-3 -ml-3 rounded-lg before:absolute before:left-0 before:top-3 before:size-4 before:rounded-full before:bg-[var(--color-primary)] before:ring-2 before:ring-[var(--border-color)] before:z-10 before:shadow-md before:transition-all hover:before:bg-[var(--color-secondary)] hover:before:ring-[var(--color-secondary)] before:glow-sm hover:before:glow-md transition-all hover:translate-x-1 hover:bg-[var(--bg-secondary)]/50 hover:shadow-md group">
  <div class="flex items-center gap-4 mb-3">
    <div class="size-10 rounded-lg overflow-hidden flex items-center justify-center bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] p-0.5 shadow-md ring-1 ring-[var(--border-color)] transition-all group-hover:shadow-lg">
      <img src={logo} alt={`${company} logo`} class="size-full object-cover bg-[var(--bg-primary)] p-1 rounded-md transition-transform group-hover:scale-110" />
    </div>
    <div>
      <h3 class="text-lg font-semibold text-[var(--text-primary)] group-hover:text-[var(--color-primary)] transition-colors">{role}</h3>
      <p class="text-sm font-medium text-[var(--color-secondary)]">{company}</p>
    </div>
  </div>
  <p class="text-sm font-medium text-[var(--text-primary)]/80 mb-2 italic pl-2 border-l-2 border-[var(--color-secondary)]">{dates}</p>
  <p class="text-[var(--text-primary)]/90 leading-relaxed mb-4">{description}</p>
  
  {technologies.length > 0 && (
    <div class="mt-3 px-2 py-3 bg-[var(--bg-primary)]/50 rounded-lg border border-[var(--border-color)] transition-all group-hover:border-[var(--color-secondary)] group-hover:shadow-md">
      <h4 class="text-sm font-medium text-[var(--text-primary)] mb-3 flex items-center gap-2 pb-2 border-b border-[var(--border-color)] group-hover:border-[var(--color-secondary)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-[var(--color-primary)] group-hover:text-[var(--color-secondary)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/><path d="M4.14 15.08c2.62-1.57 5.24-1.43 7.86.42 2.74 1.94 5.49 2 8.23.19"/></svg>
        <span>{technologiesLabel}</span>
      </h4>
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech, i) => (
          <span 
            class="px-3 py-1 text-xs font-medium rounded-full bg-[var(--bg-secondary)]/50 text-[var(--text-secondary)] border border-[var(--border-color)] hover:bg-gradient-to-r hover:from-[var(--color-primary)] hover:to-[var(--color-secondary)] hover:text-white transition-all duration-300 cursor-default transform hover:scale-105 shadow-sm group-hover:translate-y-0 translate-y-0"
            style={`transition-delay: ${i * 50}ms;`}
          >
            {tech}
          </span>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .group:hover .group-hover\:translate-y-0 {
    transform: translateY(-2px);
  }
  
  .translate-y-0 {
    transform: translateY(0);
    transition: transform 0.3s ease;
  }
  
  .before\:glow-sm::before {
    box-shadow: 0 0 5px 1px var(--color-primary);
  }
  
  .hover\:before\:glow-md:hover::before {
    box-shadow: 0 0 8px 2px var(--color-secondary);
  }
</style> 