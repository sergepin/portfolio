---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/routes';
import "../styles/global.css";
import { routes } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname.split('/')[2] || 'home';
    const validPaths = Object.keys(routes.en) as (keyof typeof routes.en)[];
    const route = validPaths.includes(currentPath as any) ? (currentPath as keyof typeof routes.en) : 'home';
---
<!doctype html>
<html lang={lang} class="transition-colors duration-200">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-200">
		<nav class="bg-white dark:bg-gray-800 shadow-sm">
			<div class="container mx-auto px-4 py-4">
				<div class="flex justify-between items-center">
					<div class="flex items-center space-x-8">
						<a href={getLocalizedPath(lang, 'home')} class="text-xl font-bold text-gray-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
							Sergio
						</a>
						<div class="hidden md:flex space-x-6">
							<a href={getLocalizedPath(lang, 'home')} class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
								{t('nav.home')}
							</a>
							<a href={getLocalizedPath(lang, 'about')} class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
								{t('nav.about')}
							</a>
							<a href={getLocalizedPath(lang, 'projects')} class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
								{t('nav.projects')}
							</a>
							<a href={getLocalizedPath(lang, 'contact')} class="text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
								{t('nav.contact')}
							</a>
						</div>
					</div>
					<div class="flex items-center space-x-4">
						<button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
							<svg class="w-5 h-5" id="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
							</svg>
							<svg class="w-5 h-5 hidden" id="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
							</svg>
						</button>
						<div class="flex items-center space-x-2">
							<a href={getLocalizedPath('en', route)} class={`text-sm ${lang === 'en' ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400'}`}>
								EN
							</a>
							<span class="text-gray-300 dark:text-gray-600">|</span>
							<a href={getLocalizedPath('es', route)} class={`text-sm ${lang === 'es' ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400'}`}>
								ES
							</a>
						</div>
					</div>
				</div>
			</div>
		</nav>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	// Versión corregida sin TypeScript
	function updateTheme(isDark:boolean) {
		if (isDark) {
			document.documentElement.classList.add('dark');
		} else {
			document.documentElement.classList.remove('dark');
		}
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		
		const sunIcon = document.getElementById('sun-icon');
		const moonIcon = document.getElementById('moon-icon');
		
		if (sunIcon && moonIcon) {
			sunIcon.classList.toggle('hidden', isDark);
			moonIcon.classList.toggle('hidden', !isDark);
		}
	}
	
	document.addEventListener('DOMContentLoaded', () => {
		const themeToggle = document.getElementById('theme-toggle');
		if (themeToggle) {
			themeToggle.addEventListener('click', () => {
				const isDark = document.documentElement.classList.contains('dark');
				updateTheme(!isDark);
			});
		}
	});
	</script>

<script is:inline>
    (function() {
        const theme = localStorage.getItem('theme') || 'light';
        const isDark = theme === 'dark';
        const htmlElement = document.documentElement;
        
        // Aplicar clase dark
        if (isDark) htmlElement.classList.add('dark');
        
        // Actualizar iconos
        const sunIcon = document.getElementById('sun-icon');
        const moonIcon = document.getElementById('moon-icon');
        if (sunIcon && moonIcon) {
            sunIcon.classList.toggle('hidden', isDark);
            moonIcon.classList.toggle('hidden', !isDark);
        }
    })();
</script>
