---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/routes';
import "../styles/global.css";
import { routes } from '../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname.split('/')[2] || 'home';
const validPaths = Object.keys(routes.en) as (keyof typeof routes.en)[];
const route = validPaths.includes(currentPath as any) ? (currentPath as keyof typeof routes.en) : 'home';

const pages = ['home', 'about', 'projects', 'contact'] as const;
type Page = typeof pages[number];
type NavKey = `nav.${Page}`;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
</head>
<body class="min-h-screen bg-background-primary text-primary transition-colors duration-200">
    <nav class="bg-background-primary shadow-sm">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-8">
                <a href={getLocalizedPath(lang, 'home')} class="text-xl font-bold text-primary hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Sergio</a>
                <div class="hidden md:flex space-x-6">
                    {pages.map((page) => (
                        <a href={getLocalizedPath(lang, page)} class="text-secondary hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                            {t(`nav.${page}` as NavKey)}
                        </a>
                    ))}
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <button id="theme-toggle" class="p-2 rounded-lg bg-background-secondary text-secondary hover:bg-background-secondary/80 transition-colors">
                    <svg class="w-5 h-5" id="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <svg class="w-5 h-5 hidden" id="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                </button>
                <div class="flex items-center space-x-2">
                    {['en', 'es'].map(language => (
                        <a href={getLocalizedPath(language, route)} class={`text-sm ${lang === language ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-secondary hover:text-blue-600 dark:hover:text-blue-400'}`} data-lang={language}>
                            {language.toUpperCase()}
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </nav>
    <div id="content-wrapper">
        <slot />
    </div>
</body>
</html>

<style>
html, body {
    margin: 0;
    width: 100%;
    height: 100%;
}
#content-wrapper {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 64px);
}
</style>

<script is:inline>
const savedTheme = localStorage.getItem('theme');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : prefersDark);
document.documentElement.classList.toggle('light', savedTheme ? savedTheme === 'light' : !prefersDark);
</script>

<script>
const themeToggle = document.getElementById('theme-toggle');
const sunIcon = document.getElementById('sun-icon');
const moonIcon = document.getElementById('moon-icon');

if (themeToggle && sunIcon && moonIcon) {
    function updateTheme(isDark: boolean) {
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.toggle('light', !isDark);
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        sunIcon?.classList.toggle('hidden', isDark);
        moonIcon?.classList.toggle('hidden', !isDark);
    }

    themeToggle.addEventListener('click', () => updateTheme(!document.documentElement.classList.contains('dark')));
    updateTheme(document.documentElement.classList.contains('dark'));
}
</script>
