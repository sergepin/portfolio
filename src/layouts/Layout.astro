---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/routes';
import "../styles/global.css";
import { routes } from '../i18n/routes';
import SEO from '../components/SEO.astro';
import "../styles/Layout.css";
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
}

const { title, description, image, article } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname.split('/')[2] || 'home';
const validPaths = Object.keys(routes.en) as (keyof typeof routes.en)[];
const route = validPaths.includes(currentPath as any) ? (currentPath as keyof typeof routes.en) : 'home';

const pages = ['home', 'about', 'projects', 'contact'] as const;
type Page = typeof pages[number];
type NavKey = `nav.${Page}`;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO 
      title={title}
      description={description}
      image={image}
      article={article}
      lang={lang}
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="min-h-screen h-fit text-primary transition-colors duration-300 relative overflow-x-hidden">
    <!-- Fondo con cuadrícula y gradiente -->
    <div class="absolute inset-0 -z-10 h-full w-full bg-grid">
        <!-- Gradiente radial modo claro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-light"></div>
        
        <!-- Gradiente radial modo oscuro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-dark"></div>
        
        <!-- Gradiente radial adicional para más profundidad - Modo claro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-light-secondary"></div>
        
        <!-- Sutiles círculos decorativos para modo claro -->
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-sky-100/30 blur-3xl decoration-light"></div>
        <div class="absolute bottom-1/4 left-1/3 w-72 h-72 rounded-full bg-blue-100/20 blur-2xl decoration-light"></div>
        
        <!-- Gradiente radial adicional para más profundidad - Modo oscuro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-dark-secondary"></div>
    </div>

    <div id="content-wrapper" class="content-wrapper">
        <Navbar />
        <slot />
        <Footer />
    </div>
</body>
</html>


<script type="module" src="/src/scripts/langSwitcher.ts"></script>
