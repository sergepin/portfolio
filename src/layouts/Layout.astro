---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/routes';
import "../styles/global.css";
import { routes } from '../i18n/routes';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { 
  title, 
  description = 'Full Stack Developer specializing in modern web technologies. Building scalable and performant applications with React, Node.js, and cloud technologies.',
  image = '/images/og-image.jpg',
  article = false
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname.split('/')[2] || 'home';
const validPaths = Object.keys(routes.en) as (keyof typeof routes.en)[];
const route = validPaths.includes(currentPath as any) ? (currentPath as keyof typeof routes.en) : 'home';

const pages = ['home', 'about', 'projects', 'contact'] as const;
type Page = typeof pages[number];
type NavKey = `nav.${Page}`;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO 
      title={title}
      description={description}
      image={image}
      article={article}
      lang={lang}
    />
    <title>{title}</title>
</head>
<body class="min-h-screen h-fit text-primary transition-colors duration-300 relative overflow-x-hidden">
    <!-- Fondo con cuadrícula y gradiente -->
    <div class="absolute inset-0 -z-10 h-full w-full bg-grid">
        <!-- Gradiente radial modo claro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-light"></div>
        
        <!-- Gradiente radial modo oscuro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-dark"></div>
        
        <!-- Gradiente radial adicional para más profundidad - Modo claro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-light-secondary"></div>
        
        <!-- Sutiles círculos decorativos para modo claro -->
        <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-sky-100/30 blur-3xl decoration-light"></div>
        <div class="absolute bottom-1/4 left-1/3 w-72 h-72 rounded-full bg-blue-100/20 blur-2xl decoration-light"></div>
        
        <!-- Gradiente radial adicional para más profundidad - Modo oscuro -->
        <div class="absolute bottom-0 left-0 right-0 top-0 gradient-dark-secondary"></div>
    </div>

    <nav class="navbar border-b sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <a href={getLocalizedPath(lang, 'home')} class="text-xl font-bold text-primary hover:text-indigo-600 transition-all relative group">
                        Sergio
                        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-sky-500 group-hover:w-full transition-all duration-300"></span>
                    </a>
                </div>
                <!-- Mobile menu button -->
                <button id="mobile-menu-button" class="md:hidden p-2 rounded-lg text-secondary hover:text-primary hover:bg-gray-100 transition-all" aria-label="Toggle menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <!-- Desktop navigation -->
                <div class="hidden md:flex items-center space-x-4">
                    {pages.map((page) => (
                        <a
                            href={getLocalizedPath(lang, page)}
                            class={`text-sm font-medium transition-all duration-300 relative overflow-hidden px-3 py-2 rounded-md ${
                                route === page
                                    ? 'theme-text theme-bg after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-sky-500 after:rounded-full'
                                    : 'text-secondary theme-hover after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-sky-500 after:rounded-full after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:duration-300'
                            }`}
                        >
                            {t(`nav.${page}` as NavKey)}
                        </a>
                    ))}
                    <button
                        id="theme-toggle"
                        class="p-2 rounded-lg text-secondary theme-hover transition-all"
                        aria-label="Toggle theme"
                    >
                        <svg
                            id="sun-icon"
                            class="w-5 h-5 hidden"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                            />
                        </svg>
                        <svg
                            id="moon-icon"
                            class="w-5 h-5 hidden"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                            />
                        </svg>
                    </button>
                    <div class="flex items-center space-x-2 pl-2 border-l theme-border">
                        {['en', 'es'].map(language => (
                            <button
                                data-lang={language}
                                class={`text-sm font-medium px-2 py-1 rounded transition-all ${
                                    lang === language
                                        ? 'theme-text theme-bg'
                                        : 'text-secondary theme-hover'
                                }`}
                            >
                                {language.toUpperCase()}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
            <!-- Mobile navigation -->
            <div id="mobile-menu" class="hidden md:hidden mobile-menu backdrop-blur-lg border-t">
                <div class="container mx-auto px-4 py-2">
                    <div class="flex flex-col space-y-2">
                        {pages.map((page) => (
                            <a
                                href={getLocalizedPath(lang, page)}
                                class={`text-sm font-medium py-2 px-3 rounded-md transition-all duration-300 ${
                                    route === page
                                        ? 'theme-text theme-bg relative after:absolute after:bottom-0 after:left-4 after:right-4 after:h-0.5 after:bg-sky-500 after:rounded-full'
                                        : 'text-secondary theme-hover'
                                }`}
                            >
                                {t(`nav.${page}` as NavKey)}
                            </a>
                        ))}
                        <button
                            id="mobile-theme-toggle"
                            class="flex items-center text-sm font-medium py-2 px-3 rounded-md text-secondary theme-hover transition-all"
                            aria-label="Toggle theme"
                        >
                            <span id="mobile-theme-text" class="mr-2">Theme</span>
                            <svg id="mobile-sun-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
                            </svg>
                            <svg id="mobile-moon-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
                            </svg>
                        </button>
                        <div class="flex items-center space-x-2 py-2 border-t theme-border mt-2">
                            {['en', 'es'].map(language => (
                                <button
                                    data-lang={language}
                                    class={`text-sm font-medium px-3 py-1 rounded-md transition-all ${
                                        lang === language
                                            ? 'theme-text theme-bg'
                                            : 'text-secondary theme-hover'
                                    }`}
                                >
                                    {language.toUpperCase()}
                                </button>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div id="content-wrapper" class="content-wrapper animate-fade-in">
        <slot />
    </div>
</body>
</html>

<style>
html, body {
    margin: 0;
    width: 100%;
    height: fit-content;
}

html.dark {
    --bg-color: #0f172a;
    --grid-color: #1e293b;
    --text-highlight: #818cf8;
    --bg-accent: #1e293b;
    --border-color: #334155;
}

html.light {
    --bg-color: #f8fafc;  /* slate-50 */
    --grid-color: #e2e8f0; /* slate-200 */
    --text-highlight: #0284c7; /* sky-600 */
    --bg-accent: #e0f2fe;  /* sky-50 */
    --border-color: #e2e8f0;
}

#content-wrapper {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 64px);
    opacity: 1;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeOut {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(10px);
    }
}

/* Clase personalizada para el fondo */
.bg-grid {
    background-color: var(--bg-color);
    background-image: 
        linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
        linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
    background-size: 6rem 4rem;
}

/* Clases para el gradiente en modo claro */
.gradient-light {
    background: radial-gradient(circle 800px at 100% 200px, #bae6fd, transparent);
    opacity: 0;
}
html.light .gradient-light {
    opacity: 1;
}

/* Clases para el gradiente en modo oscuro */
.gradient-dark {
    background: radial-gradient(circle 800px at 100% 200px, #8b5cf6, transparent);
    opacity: 0;
}
html.dark .gradient-dark {
    opacity: 1;
}

/* Gradiente secundario claro */
.gradient-light-secondary {
    background: radial-gradient(circle 600px at 0% 80%, rgba(186,230,253,0.4), transparent);
    opacity: 0;
}
html.light .gradient-light-secondary {
    opacity: 1;
}

/* Gradiente secundario oscuro */
.gradient-dark-secondary {
    background: radial-gradient(circle 600px at 0% 80%, rgba(139,92,246,0.3), transparent);
    opacity: 0;
}
html.dark .gradient-dark-secondary {
    opacity: 1;
}

/* Círculos decorativos modo claro */
.decoration-light {
    opacity: 0;
}
html.light .decoration-light {
    opacity: 1;
}

/* Estilos específicos para la barra de navegación */
.navbar {
    backdrop-filter: blur(16px);
    transition: all 0.3s;
}
html.light .navbar {
    background-color: rgba(255, 255, 255, 0.9);
    border-color: rgba(226, 232, 240, 0.6);
}
html.dark .navbar {
    background-color: rgba(15, 23, 42, 0.8);
    border-color: rgba(51, 65, 85, 0.6);
}

/* Estilos específicos para el modo oscuro/claro */
html.dark .theme-text {
    color: #818cf8; /* indigo-400 */
}
html.light .theme-text {
    color: #0284c7; /* sky-600 */
}

html.dark .theme-bg {
    background-color: rgba(30, 41, 59, 0.2); /* slate-800/20 */
}
html.light .theme-bg {
    background-color: rgba(224, 242, 254, 0.5); /* sky-50/50 */
}

html.dark .theme-border {
    border-color: rgba(51, 65, 85, 0.6); /* slate-700/60 */
}
html.light .theme-border {
    border-color: rgba(226, 232, 240, 0.6); /* slate-200/60 */
}

html.dark .theme-hover:hover {
    background-color: rgba(30, 41, 59, 0.2); /* slate-800/20 */
    color: #818cf8; /* indigo-400 */
}
html.light .theme-hover:hover {
    background-color: rgba(224, 242, 254, 0.5); /* sky-50/50 */
    color: #0284c7; /* sky-600 */
}

/* Estilos para el menú móvil */
html.dark .mobile-menu {
    background-color: rgba(15, 23, 42, 0.9);
    border-color: rgba(51, 65, 85, 0.6);
}
html.light .mobile-menu {
    background-color: rgba(255, 255, 255, 0.9);
    border-color: rgba(226, 232, 240, 0.6);
}
</style>

<script is:inline>
// Definir preferencias de tema y aplicar inmediatamente
const savedTheme = localStorage.getItem('theme');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

// Detectar tema del sistema si no hay preferencia guardada
const isDark = savedTheme ? savedTheme === 'dark' : prefersDark;

// Aplicar tema inicial (antes de que se renderice la página)
document.documentElement.classList.toggle('dark', isDark);
document.documentElement.classList.toggle('light', !isDark);

// Establecer variables CSS de color dinámicamente
if (!isDark) {
    document.documentElement.style.setProperty('--bg-primary', '#ffffff');
    document.documentElement.style.setProperty('--bg-secondary', '#f8fafc');
} else {
    document.documentElement.style.setProperty('--bg-primary', '#0f172a');
    document.documentElement.style.setProperty('--bg-secondary', '#1e293b');
}
</script>

<script>
// Esperar a que el DOM esté cargado
document.addEventListener('DOMContentLoaded', function() {
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    const mobileSunIcon = document.getElementById('mobile-sun-icon');
    const mobileMoonIcon = document.getElementById('mobile-moon-icon');
    const mobileThemeText = document.getElementById('mobile-theme-text');

    // Función para actualizar el tema
    function updateTheme(isDark: boolean) {
        // Actualizar clases en el elemento raíz (html)
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.toggle('light', !isDark);
        
        // Guardar preferencia
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        
        // Actualizar iconos del escritorio
        if (sunIcon) sunIcon.classList.toggle('hidden', isDark);
        if (moonIcon) moonIcon.classList.toggle('hidden', !isDark);
        
        // Actualizar iconos y texto móvil
        if (mobileSunIcon) mobileSunIcon.classList.toggle('hidden', isDark);
        if (mobileMoonIcon) mobileMoonIcon.classList.toggle('hidden', !isDark);
        if (mobileThemeText) {
            mobileThemeText.textContent = isDark ? 'Light Mode' : 'Dark Mode';
        }
        
        // Actualizar variables CSS dinámicamente
        if (!isDark) {
            document.documentElement.style.setProperty('--bg-primary', '#ffffff');
            document.documentElement.style.setProperty('--bg-secondary', '#f8fafc');
        } else {
            document.documentElement.style.setProperty('--bg-primary', '#0f172a');
            document.documentElement.style.setProperty('--bg-secondary', '#1e293b');
        }
    }

    // Configurar el estado inicial de los iconos
    if (sunIcon && moonIcon) {
        const isDark = document.documentElement.classList.contains('dark');
        sunIcon.classList.toggle('hidden', isDark);
        moonIcon.classList.toggle('hidden', !isDark);

        if (mobileSunIcon) mobileSunIcon.classList.toggle('hidden', isDark);
        if (mobileMoonIcon) mobileMoonIcon.classList.toggle('hidden', !isDark);
        if (mobileThemeText) {
            mobileThemeText.textContent = isDark ? 'Light Mode' : 'Dark Mode';
        }
    }

    // Añadir listener para cambiar el tema
    if (themeToggle) {
        themeToggle.addEventListener('click', function() {
            const isDark = document.documentElement.classList.contains('dark');
            updateTheme(!isDark);
        });
    }

    // Language change animation
    document.querySelectorAll('button[data-lang]').forEach(button => {
        button.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const targetLang = target.getAttribute('data-lang');
            if (!targetLang) return;

            const currentPath = window.location.pathname;
            const newPath = currentPath.replace(/^\/[^\/]+/, `/${targetLang}`);

            // Create overlay with language indicator
            const overlay = document.createElement('div');
            overlay.className = 'fixed inset-0 bg-background-primary z-50 flex items-center justify-center animate-fade-in';
            overlay.innerHTML = `
                <div class="text-center">
                    <span class="text-4xl font-bold text-primary block mb-2">${targetLang.toUpperCase()}</span>
                    <span class="text-secondary text-sm">${targetLang === 'en' ? 'Loading...' : 'Cargando...'}</span>
                </div>
            `;
            document.body.appendChild(overlay);

            // Fade out current content
            const contentWrapper = document.querySelector('.content-wrapper') as HTMLElement;
            if (contentWrapper) {
                contentWrapper.style.animation = 'fadeOut 0.3s ease-in-out forwards';
            }

            // After content fades out, navigate to new language
            setTimeout(() => {
                window.location.href = newPath;
            }, 300);
        });
    });

    // Page transition animation
    const contentWrapper = document.querySelector('.content-wrapper') as HTMLElement;
    if (contentWrapper) {
        contentWrapper.style.animation = 'fadeIn 0.3s ease-in-out forwards';
    }

    // Mobile menu functionality
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

    if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    }

    if (mobileThemeToggle) {
        mobileThemeToggle.addEventListener('click', () => {
            const isDark = document.documentElement.classList.contains('dark');
            updateTheme(!isDark);
        });
    }
});
</script>
