---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getLocalizedPath } from '../i18n/routes';
import "../styles/global.css";
import { routes } from '../i18n/routes';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { 
  title, 
  description = 'Full Stack Developer specializing in modern web technologies. Building scalable and performant applications with React, Node.js, and cloud technologies.',
  image = '/images/og-image.jpg',
  article = false
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = new URL(Astro.request.url).pathname.split('/')[2] || 'home';
const validPaths = Object.keys(routes.en) as (keyof typeof routes.en)[];
const route = validPaths.includes(currentPath as any) ? (currentPath as keyof typeof routes.en) : 'home';

const pages = ['home', 'about', 'projects', 'contact'] as const;
type Page = typeof pages[number];
type NavKey = `nav.${Page}`;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/icons/logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO 
      title={title}
      description={description}
      image={image}
      article={article}
      lang={lang}
    />
    <title>{title}</title>
</head>
<body class="min-h-screen bg-background-primary text-primary transition-colors duration-200">
    <nav class="bg-background-primary border-b border-border">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <a href={getLocalizedPath(lang, 'home')} class="text-xl font-bold text-primary hover:text-secondary transition-colors">
                        Sergio
                    </a>
                </div>
                <!-- Mobile menu button -->
                <button id="mobile-menu-button" class="md:hidden p-2 rounded-lg text-secondary hover:text-primary transition-colors" aria-label="Toggle menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <!-- Desktop navigation -->
                <div class="hidden md:flex items-center space-x-4">
                    {pages.map((page) => (
                        <a
                            href={getLocalizedPath(lang, page)}
                            class={`text-sm font-medium transition-colors ${
                                route === page
                                    ? 'text-primary'
                                    : 'text-secondary hover:text-primary'
                            }`}
                        >
                            {t(`nav.${page}` as NavKey)}
                        </a>
                    ))}
                    <button
                        id="theme-toggle"
                        class="p-2 rounded-lg text-secondary hover:text-primary transition-colors"
                        aria-label="Toggle theme"
                    >
                        <svg
                            id="sun-icon"
                            class="w-5 h-5 hidden"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                            />
                        </svg>
                        <svg
                            id="moon-icon"
                            class="w-5 h-5 hidden"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                            />
                        </svg>
                    </button>
                    <div class="flex items-center space-x-2">
                        {['en', 'es'].map(language => (
                            <button
                                data-lang={language}
                                class={`text-sm font-medium transition-colors ${
                                    lang === language
                                        ? 'text-primary'
                                        : 'text-secondary hover:text-primary'
                                }`}
                            >
                                {language.toUpperCase()}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
            <!-- Mobile navigation -->
            <div id="mobile-menu" class="hidden md:hidden">
                <div class="px-2 pt-2 pb-3 space-y-1">
                    {pages.map((page) => (
                        <a
                            href={getLocalizedPath(lang, page)}
                            class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
                                route === page
                                    ? 'text-primary bg-background-secondary'
                                    : 'text-secondary hover:text-primary hover:bg-background-secondary'
                            }`}
                        >
                            {t(`nav.${page}` as NavKey)}
                        </a>
                    ))}
                    <div class="px-3 py-2 flex items-center justify-between">
                        <span class="text-secondary">Theme</span>
                        <button
                            id="mobile-theme-toggle"
                            class="p-2 rounded-lg text-secondary hover:text-primary transition-colors"
                            aria-label="Toggle theme"
                        >
                            <svg
                                id="mobile-sun-icon"
                                class="w-5 h-5 hidden"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                                />
                            </svg>
                            <svg
                                id="mobile-moon-icon"
                                class="w-5 h-5 hidden"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
                                />
                            </svg>
                        </button>
                    </div>
                    <div class="px-3 py-2 flex items-center justify-between">
                        <span class="text-secondary">Language</span>
                        <div class="flex space-x-2">
                            {['en', 'es'].map(language => (
                                <button
                                    data-lang={language}
                                    class={`text-sm font-medium transition-colors ${
                                        lang === language
                                            ? 'text-primary'
                                            : 'text-secondary hover:text-primary'
                                    }`}
                                >
                                    {language.toUpperCase()}
                                </button>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div id="content-wrapper" class="content-wrapper animate-fade-in">
        <slot />
    </div>
</body>
</html>

<style>
html, body {
    margin: 0;
    width: 100%;
    height: 100%;
}
#content-wrapper {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 64px);
    opacity: 1;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeOut {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(10px);
    }
}
</style>

<script is:inline>
const savedTheme = localStorage.getItem('theme');
const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
document.documentElement.classList.toggle('dark', savedTheme ? savedTheme === 'dark' : prefersDark);
document.documentElement.classList.toggle('light', savedTheme ? savedTheme === 'light' : !prefersDark);
</script>

<script>
const themeToggle = document.getElementById('theme-toggle');
const sunIcon = document.getElementById('sun-icon');
const moonIcon = document.getElementById('moon-icon');

function updateTheme(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.classList.toggle('light', !isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    sunIcon?.classList.toggle('hidden', isDark);
    moonIcon?.classList.toggle('hidden', !isDark);
}

if (themeToggle && sunIcon && moonIcon) {
    themeToggle.addEventListener('click', () => updateTheme(!document.documentElement.classList.contains('dark')));
    updateTheme(document.documentElement.classList.contains('dark'));
}

// Language change animation
document.querySelectorAll('button[data-lang]').forEach(button => {
    button.addEventListener('click', (e) => {
        const targetLang = (e.currentTarget as HTMLButtonElement).getAttribute('data-lang');
        if (!targetLang) return;

        const currentPath = window.location.pathname;
        const newPath = currentPath.replace(/^\/[^\/]+/, `/${targetLang}`);

        // Create overlay with language indicator
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-background-primary z-50 flex items-center justify-center animate-fade-in';
        overlay.innerHTML = `
            <div class="text-center">
                <span class="text-4xl font-bold text-primary block mb-2">${targetLang.toUpperCase()}</span>
                <span class="text-secondary text-sm">${targetLang === 'en' ? 'Loading...' : 'Cargando...'}</span>
            </div>
        `;
        document.body.appendChild(overlay);

        // Fade out current content
        const contentWrapper = document.querySelector('.content-wrapper');
        if (contentWrapper instanceof HTMLElement) {
            contentWrapper.style.animation = 'fadeOut 0.3s ease-in-out forwards';
        }

        // After content fades out, navigate to new language
        setTimeout(() => {
            window.location.href = newPath;
        }, 300);
    });
});

// Page transition animation
document.addEventListener('astro:page-load', () => {
    const contentWrapper = document.querySelector('.content-wrapper');
    if (contentWrapper instanceof HTMLElement) {
        contentWrapper.style.animation = 'fadeIn 0.3s ease-in-out forwards';
    }
});

// Mobile menu functionality
const mobileMenuButton = document.getElementById('mobile-menu-button');
const mobileMenu = document.getElementById('mobile-menu');
const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
const mobileSunIcon = document.getElementById('mobile-sun-icon');
const mobileMoonIcon = document.getElementById('mobile-moon-icon');

if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });
}

if (mobileThemeToggle && mobileSunIcon && mobileMoonIcon) {
    function updateMobileTheme(isDark: boolean) {
        mobileSunIcon?.classList.toggle('hidden', isDark);
        mobileMoonIcon?.classList.toggle('hidden', !isDark);
    }

    mobileThemeToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        updateTheme(!isDark);
        updateMobileTheme(!isDark);
    });

    updateMobileTheme(document.documentElement.classList.contains('dark'));
}
</script>
