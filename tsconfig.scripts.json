{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "outDir": "public/scripts",
      "rootDir": "src/scripts",
      "strict": true,
      "allowJs": false,
      "esModuleInterop": true
    },
    "include": ["src/scripts"]
  }
  